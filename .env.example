# Mcord public bot — add these as Infrlo Environment Variables
MCORD_BOT_TOKEN=put-your-bot-token-here
MCORD_APPLICATION_ID=put-your-application-id-here
MCORD_API_BASE=https://mcord.ir

# Do not set a fixed guild or voice channel for a public bot.
# The bot will use the guild/channel from the user's command.

# Music / FFmpeg
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
