# Required on Infrlo
MCORD_BOT_TOKEN=put-your-bot-token-here

# Optional YouTube authentication for the direct fallback.
# Never commit the cookies file itself to GitHub.
# YOUTUBE_COOKIES_B64=...

# Optional direct YouTube fallback settings.
# Multiple proxies may be comma-separated; one is chosen per request/run.
# YOUTUBE_PROXY=http://user:password@host:port,http://user2:password@host:port
# YOUTUBE_USER_AGENT=Mozilla/5.0 ...
#
# Current yt-dlp YouTube clients. Keep this conservative for compatibility.
# YTDLP_PLAYER_CLIENTS=android_vr,web_embedded
#
# Optional browser/TLS impersonation. Requires curl-cffi (already installed
# by the yt-dlp[default,curl-cffi] dependency). Example:
# YTDLP_IMPERSONATE=chrome

# Optional overrides
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
