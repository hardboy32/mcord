# Required on Infrlo
MCORD_BOT_TOKEN=put-your-bot-token-here

# YouTube authentication (optional, but recommended for restricted videos)
# Never commit the cookies file itself to GitHub.
# Put the Base64 contents into this variable on Infrlo.
# YOUTUBE_COOKIES_B64=...

# Optional YouTube network fallback.
# If YouTube blocks the Infrlo/datacenter IP, set a proxy URL here.
# YOUTUBE_PROXY=http://user:password@host:port

# Optional: browser User-Agent matching the cookies/session.
# YOUTUBE_USER_AGENT=Mozilla/5.0 ...

# Optional overrides
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
